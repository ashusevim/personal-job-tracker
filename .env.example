# Local development only. Copy to .env and replace the password hash.
# Generate the hash with: flask --app job_tracker hash-password
JOB_TRACKER_PASSWORD_HASH=

# Optional: use a Neon pooled connection string for local production-like testing.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: enable the X-Forwarded-* headers when running behind a trusted proxy.
# TRUST_PROXY=0
